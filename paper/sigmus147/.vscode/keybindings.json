[
  {
    "key": "ctrl+alt+c",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\cite{${1:key}}"
    }
  },
  {
    "key": "ctrl+b",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\textbf{${TM_SELECTED_TEXT}}"
    }
  },
  {
    "key": "ctrl+i",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\textit{${TM_SELECTED_TEXT}}"
    }
  },
  {
    "key": "ctrl+d",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\deleted{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+d",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\deleted{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+a",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\added{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+a",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\added{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+c",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\commented{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+h",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\highlight{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+r",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\needRef{${TM_SELECTED_TEXT:$1}}"
    }
  },
  {
    "key": "ctrl+shift+m",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\modified{${TM_SELECTED_TEXT:$1}}{${2:修正後}}"
    }
  },
  {
    "key": "ctrl+shift+alt+h",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\highlightComment{${TM_SELECTED_TEXT:$1}}{${2:コメント}}"
    }
  },
  {
    "key": "ctrl+e",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\(${TM_SELECTED_TEXT:$1}\\)"
    }
  },
  {
    "key": "ctrl+1",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\figref{${1:fig:label}}"
    }
  },
  {
    "key": "ctrl+2",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\tabref{${1:tab:label}}"
    }
  },
  {
    "key": "ctrl+3",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\eqref{${1:eq:label}}"
    }
  },
  {
    "key": "ctrl+shift+1",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\section{${1:Section Title}}"
    }
  },
  {
    "key": "ctrl+shift+2",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\subsection{${1:Subsection Title}}"
    }
  },
  {
    "key": "ctrl+shift+3",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\subsubsection{${1:Subsubsection Title}}"
    }
  },
  {
    "key": "ctrl+alt+f",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\begin{figure}[tb]\n\t\\centering\n\t\\includegraphics[width=0.8\\\\linewidth]{${1:figure}}\n\t\\caption{${2:caption}}\n\t\\label{fig:${3:label}}\n\\end{figure}"
    }
  },
  {
    "key": "ctrl+alt+t",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\begin{table}[tb]\n\t\\centering\n\t\\caption{${1:caption}}\n\t\\label{tab:${2:label}}\n\t\\begin{tabular}{${3:c}}\n\t\t${4}\n\t\\end{tabular}\n\\end{table}"
    }
  },
  {
    "key": "ctrl+alt+m",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\begin{equation}\n\t${1}\n\t\\label{eq:${2:label}}\n\\end{equation}"
    }
  },
  {
    "key": "ctrl+alt+l",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex",
    "args": {
      "snippet": "\\begin{itemize}\n\t\\item ${1}\n\\end{itemize}"
    }
  }
]